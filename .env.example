# Common overrides. Advanced defaults live in src/settings/config.py and compose.yaml.
# See docs/DESIGN.md. Copy to .env; never commit real credentials.

# Local evaluation credentials. Update the URLs below if changing these.
POSTGRES_PASSWORD=local-development
APP_PORT=8000
# Host-side tools/tests only; Compose supplies internal service URLs to containers.
DATABASE_URL=postgresql://transcriber:local-development@127.0.0.1:55432/transcriber

# Model: change ID and revision together. Defaults use CPU / int8.
MODEL_ID=Systran/faster-whisper-small
MODEL_REVISION=536b0662742c02347bc0e980a01041f333bce120

# Inference children share the API container budget. One model per child.
WORKER_CONCURRENCY=1
MODEL_CPU_THREADS=4
API_CPU_LIMIT=4
API_MEMORY_LIMIT=4g

# Uploads and retention: bytes and seconds. Starting policy, not a capacity guarantee.
MAX_UPLOAD_BYTES=104857600
MAX_DURATION_SECONDS=600
MAX_ACTIVE_JOBS=20
MAX_CONCURRENT_UPLOADS=4
MAX_STORED_BYTES=2147483648
RETENTION_SECONDS=86400

LOG_LEVEL=INFO
